{
  "name": "env-based-node-server",
  "version": "1.0.0",
  "description": "A Node.js API server that displays environment-specific messages",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "cross-env NODE_ENV=development node app.js",
    "qa": "cross-env NODE_ENV=qa node app.js",
    "uat": "cross-env NODE_ENV=uat node app.js",
    "prod": "cross-env NODE_ENV=production node app.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "keywords": ["nodejs", "api", "environment", "express"],
  "author": "Aaron",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1",
    "jest": "^29.0.0",
    "supertest": "^6.3.3"
  }
}
